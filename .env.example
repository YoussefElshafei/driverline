# Copy this file to .env and change values as needed. Never commit .env.
# These defaults are for local development only.

# PostgreSQL container (docker-compose.yml)
POSTGRES_DB=driverline
POSTGRES_USER=driverline
POSTGRES_PASSWORD=driverline
POSTGRES_PORT=5434

# planning-service
DB_URL=jdbc:postgresql://localhost:5434/driverline
DB_USERNAME=driverline
DB_PASSWORD=driverline
PLANNING_SERVICE_PORT=8080
SEED_DEMO_DATA=true
# Where planning-service finds commentary-service, and how long to wait for it
COMMENTARY_SERVICE_URL=http://localhost:8082
COMMENTARY_TIMEOUT_SECONDS=150

# commentary-service
COMMENTARY_SERVICE_PORT=8082
# "ollama" uses a local Ollama server; "none" always writes rule-based commentary (no LLM needed)
COMMENTARY_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
